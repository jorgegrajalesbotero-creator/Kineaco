# Variables de entorno de Kineaco
# Copia este archivo a `.env.local` y rellena los valores reales.
# Están en Supabase → Project Settings → API. NUNCA subas `.env.local` al repo.

# URL del proyecto de Supabase (p. ej. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" de Supabase (no la service_role, esa es secreta).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
